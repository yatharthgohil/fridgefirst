# Copy to .env.local and use your Supabase project's URL and publishable key.
# These values are public. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical browser origin for cookie-authenticated API mutations, especially behind a proxy.
APP_ORIGIN=http://localhost:3000

# Add provider secrets when implementing AI integrations.
# Server secrets must never use the NEXT_PUBLIC_ prefix.
